{
  "name": "safetynet",
  "version": "0.1.0",
  "private": true,
  "description": "SafetyNet - AI-powered personal and community safety platform (PromptWars x GDGoC MM(DU) hackathon)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "dev:all": "bun --filter \"*\" dev",
    "dev:backend": "cd backend && uv run uvicorn app.main:app --reload --port 8000",
    "dev:user": "bun --filter @safetynet/user-app dev",
    "dev:guardian": "bun --filter @safetynet/guardian-dashboard dev",
    "build": "bun --filter @safetynet/user-app build && bun --filter @safetynet/guardian-dashboard build",
    "build:user": "bun --filter @safetynet/user-app build",
    "build:guardian": "bun --filter @safetynet/guardian-dashboard build",
    "test:backend": "cd backend && uv run pytest",
    "cli": "cd cli && uv run python -m safetynet_cli"
  },
  "engines": {
    "node": ">=18"
  }
}
