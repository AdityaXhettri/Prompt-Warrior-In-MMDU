# =====================================================================
# SafetyNet backend environment variables
# Copy to `.env` and fill in the values you have. Anything left blank
# falls back to the in-memory store / deterministic engine so the demo
# still works.
# =====================================================================

# --- General ---
APP_NAME="SafetyNet API"
ENV=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

# --- Supabase / PostgreSQL ---
# Set USE_SUPABASE=true in production to enable PostgREST persistence.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
USE_SUPABASE=false

# --- Google Maps Platform ---
# Required for real Directions API and Places lookup. Demo uses polyline fallback.
GOOGLE_MAPS_API_KEY=
USE_GOOGLE_MAPS=false

# --- Twilio ---
# Required for real SMS alerts. Demo logs alerts and stores them in memory.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
USE_TWILIO=false

# --- AI / LLM ---
# Recommended: OpenAI, Anthropic, Groq, Together — any OpenAI-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
USE_LLM=false

# --- Backend behavior tuning ---
CHECK_IN_GRACE_SECONDS=120
ETA_DELAY_THRESHOLD_S=300
INACTIVITY_THRESHOLD_S=180
ROUTE_DEVIATION_M=200
OFFLINE_BUFFER_MAX=1000
